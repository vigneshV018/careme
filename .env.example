# CareMe Environment Configuration
# ========================================

# Application Details
APP_NAME="CareMe"
APP_TAGLINE="Care from anywhere. Connected by CareMe."

# Application Security
# In production (DEMO_MODE=false), SECRET_KEY is strictly required and must be a strong secret.
SECRET_KEY="careme-secret-key-hackathon-2026"

# Database Configuration
# SQLite (default): sqlite:///./caresync.db
# PostgreSQL: postgresql://user:password@hostname:5432/dbname (also supports postgres://)
DATABASE_URL="sqlite:///./caresync.db"

# Server & Runtime
PORT=8000
DEBUG=True

# Mode Switch
# Set to 'false' for Production Mode (hides demo tab, disables auto-seeding, disables /demo page)
# Set to 'true' for Hackathon / Demo Mode (pre-seeds Lakshmi, Arun, Priya, Meena, enables 1-click persona switcher and /demo page)
DEMO_MODE=true

# Timezone (Default: Asia/Kolkata - Indian Standard Time)
TIMEZONE="Asia/Kolkata"

# Background Escalation Windows (in minutes)
# ESCALATE_1_MIN: Minutes before first check-in alert to circle members with can_receive_alerts (Default: 30)
# ESCALATE_2_MIN: Minutes before critical escalation to entire care circle (Default: 120)
ESCALATE_1_MIN=30
ESCALATE_2_MIN=120

# Email Delivery (Gmail SMTP)
# Used for real email notifications, dose escalations, appointment alerts, and password resets
SMTP_USER="your-gmail@gmail.com"
SMTP_PASS="your-16-char-app-password"
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587

# Destination email for simulated testing on /demo page
TEST_EMAIL="your-test-address@example.com"

# Google Gemini Vision & Clinical Assistant (gemini-2.5-flash)
# Used for prescription scanning and weekly care summaries
GEMINI_API_KEY="your-gemini-api-key"
GEMINI_MODEL="gemini-2.5-flash"
